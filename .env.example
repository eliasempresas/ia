# Launcher EE - Variáveis de Ambiente
# Copie este arquivo para .env e configure os valores

# API Configuration
API_BASE_URL=https://api.eliasempresas.com
API_KEY=sua-chave-api-aqui
API_AUTH_ENDPOINT=/APIEE/familiaoliveiraEE/tv.php

# WebSocket Configuration
WS_CHAT_URL=wss://chat.eliasempresas.com/ws

# Module URLs
MIDIA_BASE_URL=https://midia.eliasempresas.com
CHAT_BASE_URL=https://chat.eliasempresas.com
IPTV_BASE_URL=https://iptv.eliasempresas.com
STREAMING_BASE_URL=https://streaming.eliasempresas.com
PORTAL_BASE_URL=https://portal.oliveira.eliasempresas.com

# Device Configuration
DEVICE_MODEL=LG 55UP77
DEVICE_PLATFORM=webOS

# App Configuration
APP_VERSION=1.0.0
APP_NAME=Launcher EE
APP_ID=com.eliasempresas.launcher

# Debug
DEBUG_MODE=false
LOG_LEVEL=info
SEND_LOGS_TO_SERVER=true

# TV Configuration
TV_DEVICE_NAME=lg-tv
TV_IP_ADDRESS=192.168.1.100

# Feature Flags
ENABLE_AUTO_UPDATE=true
ENABLE_TELEMETRY=true
ENABLE_OFFLINE_MODE=false

# Timeouts (in milliseconds)
API_TIMEOUT=5000
WS_RECONNECT_INTERVAL=3000
METRICS_UPDATE_INTERVAL=10000

# Security
ALLOWED_IPTV_DOMAINS=api.eliasempresas.com,cdn.eliasempresas.com,iptv.eliasempresas.com
